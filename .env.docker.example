# Copy to .env next to docker-compose.yml, then fill in what you need. Never commit .env.

# Port of the web app on your machine: http://localhost:8088
WEB_PORT=8088
# Port to reach MySQL from DB tools (the app does not need it).
MYSQL_PORT=3307
# Address people open in the browser; used for payment return links.
PUBLIC_URL=http://localhost:8088

# Server only (docker-compose.server.yml): domain pointed at the server IP.
# No domain yet? Use <server-ip>.sslip.io. Then set PUBLIC_URL=https://<that domain>.
# DOMAIN=203.0.113.10.sslip.io

# MySQL root password inside Docker.
DB_PASSWORD=sportscenter
# Start from your own data instead of the demo data (path to a .sql dump), e.g. ./my-data.sql
# DB_INIT_FILE=./Backend/database_init.sql

# Optional services. Leave empty to run without them.
MAIL_USERNAME=
MAIL_PASSWORD=
GEMINI_API_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Java memory for the backend.
JAVA_OPTS=-Xms256m -Xmx768m
