# ==============================================================================
# NEXUS Sports Center - Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Database Configuration (MySQL 8.0 / 8.4)
DB_URL=jdbc:mysql://localhost:3306/SportCenter?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=123456
MYSQL_PORT=3306

# 2. Backend & Frontend Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# 3. Persistent Upload Directories
AVATAR_UPLOAD_DIR=uploads/avatars
RESOURCE_IMAGE_UPLOAD_DIR=uploads/resource-images

# 4. Email SMTP Configuration (Gmail App Password for OTP Verification)
MAIL_USERNAME=
MAIL_PASSWORD=

# 5. Disposable Schema Test Database (For Flyway DatabaseMigrationTests in CI/Local)
MIGRATION_TEST_URL=jdbc:mysql://localhost:3306/SportCenter?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=Asia/Ho_Chi_Minh
MIGRATION_TEST_USERNAME=root
MIGRATION_TEST_PASSWORD=123456

# 6. CI/CD & DevSecOps Secrets (Configure in GitHub Repository Settings -> Secrets)
# SNYK_TOKEN=your-snyk-api-token
